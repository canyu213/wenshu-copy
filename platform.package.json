{
  "id": "wenshu-knowledge-base",
  "display_name": "wenshu",
  "version": "1.0.9",
  "description_use": "需要人文社科知识处理，包括文献导入、段落标注、引文格式化、谱系图谱、论证链、知识库检索问答等",
  "description_dont": "需要论文写作辅助（大纲设计/润色/查重）、通用对话聊天",
  "allowed_tools": ["Read", "Write", "Bash", "Glob", "Grep", "Agent", "WebSearch", "AskUserQuestion"],
  "include_dirs": ["workflows", "references", "scripts"],
  "rename_files": { "LICENSE": "LICENSE.txt" },
  "exclude_dirs": ["docs", "kb_", "work_", ".git", "__pycache__", "__tests__"],
  "exclude_files": [".env", ".gitkeep"],
  "sensitive_words": ["毛选", "毛泽东", "马恩", "列宁", "中特", "新思想", "马克思主义", "社会主义", "共产党", "国内革命", "CodeBuddy", "WorkBuddy", "Cursor", "Claude", "ChatGPT"],
  "url_whitelist": ["api.deepseek.com", "api.siliconflow.cn"],
  "readme": "exclude"
}
